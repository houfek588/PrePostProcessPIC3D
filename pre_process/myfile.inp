<--------------------------------------------------------------------------->

SaveDirName = data
# RestartDirName = data

# New flags:
Case				= none			# Select the case
PoissonCorrection	= no       # Poisson correction
WriteMethod			= pvtk
SimulationName		= 1Dwaves  # Simulation name for the output

# Path to the python script generated by ParaView
ParaviewScriptPath = ../inputfiles/storePersistenceDiagram.py
# delta = 1

#  %%%%%%%%%%%%%%%%%%%    TIME STEP PARAMETERS    %%%%%%%%%%%%%%%%%%
	dt		= 0.0001			# dt = time step
	ncycles	= 80000			# cycles
	th = 1.0					# th = decentering parameter
	c = 1.0

#  %%%%%%%%%%%%%%%%%%%    SMOOTH PARAMETER    %%%%%%%%%%%%%%%%%%
Smooth = 0.9				# Smoothing value (5-points stencil)

#  %%%%%%%%%%%%%%%%%%%    MAGNETIC FIELD PARAMETER    %%%%%%%%%%%%%%%%%%
	B0x = 0.0002300782005987522
	B0y = 0
	B0z = 0

#  %%%%%%%%%%%%%%%%%%%    BOX PARAMETERS    %%%%%%%%%%%%%%%%%%
	Lx = 0.5	# Lx = simulation box length - x direction
	Ly = 0.1	# Ly = simulation box length - y direction
	Lz = 0.1	# Lz = simulation box length - z direction

	nxc = 4096	# nxc = number of cells - x direction
	nyc = 1		# nyc = number of cells - y direction
	nzc = 1		# nzc = number of cells - z direction

#  %%%%%%%%%%%%%%%%%%%    MPI TOPOLOGY    %%%%%%%%%%%%%%%%%%
# number of MPI subdomains in each direction
	XLEN = 32
	YLEN = 1
	ZLEN = 1
# topology of subdomains in each dimension (1=true, 0=false)
	PERIODICX = 1
	PERIODICY = 1
	PERIODICZ = 1

#  %%%%%%%%%%%%%%%%%%%    PARTICLE PARAMETERS    %%%%%%%%%%%%%%%%%%
# ns = number of species
# 0 = electrons
# 1 = protons
# ...
	ns = 3

# qom = charge to mass ratio for different species
	qom = -64 1 -64 

# Initial density (make sure that plasma is neutral)
	rhoINIT = 0.999 1.0 0.001 
	rhoINJECT = 0.0 0.0 0.0 

# TrackParticleID[species] = 1=true, 0=false --> Assign ID to particles 
	TrackParticleID = 1 1 1

# uth = thermal velocity for different species - Direction X
	uth = 0.0008258964287023232 0.0001032370535877904 0.00045236210416321954 
# vth = thermal velocity for different species - Direction Y
	vth = 0.0008258964287023232 0.0001032370535877904 0.00045236210416321954 
# wth = thermal velocity for different species - Direction Z
	wth = 0.0008258964287023232 0.0001032370535877904 0.00045236210416321954 

# u0 = drift velocity   - Direction X
	u0 = 0.0 0.0 0.0022618105208160977 
# v0 = drift velocity   - Direction Y
	v0 = 0.0 0.0 0.0 
# w0 = drift velocity   - Direction Z
	w0 = 0.0 0.0 0.0 

# npcelx = number of particles per cell - Direction X
	npcelx = 50 50 30 
# npcely = number of particles per cell - Direction Y
	npcely = 1 1 1 
# npcelz = number of particles per cell - Direction Z
	npcelz = 1 1 1 

#  %%%%%%%%%%%%%%%%%%%    BOUNDARY CONDITIONS    %%%%%%%%%%%%%%%%%%

# PHI Electrostatic Potential
# 0,1 = Dirichilet boundary condition
# 2   = Neumann boundary condition
	bcPHIfaceXright = 1
	bcPHIfaceXleft  = 1
	bcPHIfaceYright = 1
	bcPHIfaceYleft  = 1
	bcPHIfaceZright = 1
	bcPHIfaceZleft  = 1

# EM field boundary condition
# 0 = perfect conductor
# 1 = magnetic mirror
# 2 = constant charge open BC
	bcEMfaceXright = 2
	bcEMfaceXleft =  2
	bcEMfaceYright = 2
	bcEMfaceYleft =  2
	bcEMfaceZright = 2
	bcEMfaceZleft =  2

# Particles Boundary condition
# 0 = exit
# 1 = perfect mirror
# 2 = riemission
# 3 = open BC out
# 4 = open BC in
# Caveat: if your processor topology is set to be periodic in a direction automatically the boundary condition in that direction will be periodic
	bcPfaceXright = 3
	bcPfaceXleft =  2
	bcPfaceYright = 3
	bcPfaceYleft =  3
	bcPfaceZright = 3
	bcPfaceZleft =  3

<--------------------------------------------------------------------------->


# print to video results
	verbose = 1

# velocity of the injection from the wall
	Vinj= 0.0

# CG solver stopping criterium tolerance
	CGtol = 1E-3

# GMRES solver stopping criterium tolerance
	GMREStol = 1E-3

# mover predictor corrector iteration
	NiterMover  = 3

# Output for field
	FieldOutputCycle = 10
	FieldOutputTag   = B+E
	MomentsOutputTag = rho

# Output for particles if 0 it doesnt save particles data
	ParticlesOutputCycle = 5000
	ParticlesOutputTag = position+velocity

# restart cycle
	RestartOutputCycle = 0
	CallFinalize=1
